[Unit]
Description=Acquire a multipage eSCL scan for Paperless-ngx
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=@SERVICE_USER@
Group=@SERVICE_GROUP@
Environment=SCANNER_CONFIG=/etc/brother-paperless-scanner/scanner.env
ExecStart=/usr/local/sbin/bps-escl-worker
Nice=5
IOSchedulingClass=best-effort
IOSchedulingPriority=6
TimeoutStartSec=300
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=@SCAN_WORK@ @PAPERLESS_CONSUME@
