# Scanner address and eSCL/SANE endpoints. Use a stable DHCP reservation.
SCANNER_HOST=192.168.1.50
ESCL_SCHEME=https
ESCL_PORT=443
ESCL_DEVICE=escl:https://192.168.1.50:443

# Paperless-ngx consume directory as mounted on this host.
PAPERLESS_CONSUME=/srv/paperless/consume
SCAN_WORK=/var/lib/brother-paperless-scanner

# Acquisition defaults.
SCAN_SOURCE=ADF
SCAN_MODE=Color
SCAN_RESOLUTION=300
READY_POLL_SECONDS=2
READY_MAX_POLLS=90
READY_POLLS_REQUIRED=2

# Optional Home Assistant / Zigbee2MQTT button listener.
# Put HA_TOKEN in the separate root-readable home-assistant.env file.
HA_URL=http://homeassistant.local:8123
ZIGBEE_DEVICE_IEEE=0x0000000000000000
ZIGBEE_DEVICE_NAME=Paperless Scanner Button
BUTTON_COOLDOWN_SECONDS=8
